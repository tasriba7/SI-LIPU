# Salin file ini jadi .env.local lalu isi sesuai project Supabase Anda.
# Lihat langkah lengkap di README.md bagian "Setup Supabase".

# Project Settings -> API Keys -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> tab "Publishable and secret API keys" -> Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> tab "Publishable and secret API keys" -> Secret key (klik "Reveal")
# PENTING: jangan beri awalan NEXT_PUBLIC_, jangan dipakai di client component, jangan di-commit.
SUPABASE_SECRET_KEY=

# OPSIONAL: kunci terpisah untuk menandatangani bukti verifikasi pengaduan.
# Kalau kosong, dipakai turunan dari SUPABASE_SECRET_KEY. Isi dengan string acak panjang.
BUKTI_VERIFIKASI_SECRET=

# OPSIONAL: kode wilayah desa (Kemendagri tingkat IV, format 00.00.00.0000) untuk
# prakiraan cuaca BMKG di /cuaca. Data BMKG TIDAK butuh API key.
# Kalau kosong, kode dicari otomatis dari Pengaturan Desa (provinsi, kabupaten,
# kecamatan, nama desa). Isi manual bila pencarian otomatis tidak cocok.
# Contoh: BMKG_KODE_ADM4=31.71.03.1001 (contoh format dari BMKG, bukan kode desa Anda)
BMKG_KODE_ADM4=
